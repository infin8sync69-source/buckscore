{
  "compilerOptions": {
    "target":             "ES2020",
    "module":             "commonjs",
    "lib":                ["ES2020"],
    "esModuleInterop":    true,
    "strict":             true,
    "skipLibCheck":       true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule":  true,
    "outDir":             "dist",
    "rootDir":            ".",
    "typeRoots":          ["./node_modules/@types"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "artifacts", "cache"]
}
