# Example settings for the Soul Engine. Copy to .env and fill in only what you use.
# Never commit a real key; rotate any key that has been pasted into a chat or a commit.
#
# Bucks Browser: the browser starts the engine itself and chooses the backend from
# Settings → Agent. Put API keys for the cloud backends in <profile>/soul-engine/.env
# (Settings shows the exact path), not here. Values the browser owns (the token, the
# data folders, MODEL_PROVIDER) cannot be overridden from that file.
#
# Running by hand (agent/start_soul_engine.sh or uvicorn): this file is read from the
# agent/ folder.

# ── Backend ────────────────────────────────────────────────────────────────
# edge   = embedded on-device model (default; downloads the weights once)
# ollama = a local Ollama server
# nim / litai = cloud providers with your own key; prompts leave the device
MODEL_PROVIDER=edge

# ── Embedded / Ollama models ──────────────────────────────────────────────
# SLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# BUCKS_MODEL=hermes3:latest

# ── Lightning AI (cloud, opt-in) ──────────────────────────────────────────
LITAI_API_KEY=
LITAI_BASE_URL=https://lightning.ai/api/v1
LITAI_MODEL=lightning-ai/deepseek-v4-pro

# ── NVIDIA NIM (cloud, or a NIM container on your own GPU) ────────────────
NGC_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=deepseek-ai/deepseek-v4-pro

# ── Optional: cloud copy of the swarm servers' session memory ─────────────
# Off unless set. server.py / server_lite.py only; the Soul Engine does not use it.
# DATABASE_URL=postgresql://user:password@host:5432/db

# ── Security (set automatically by Bucks Browser) ─────────────────────────
# BUCKS_SOUL_TOKEN=   bearer token required by every endpoint except GET /health
# BUCKS_MCP_TOKEN=    the same for mcp_server.py
