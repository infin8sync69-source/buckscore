# Copy this file to .env and fill in your real keys.
# IMPORTANT: rotate any API key that has been pasted into chat or committed.

# ── Provider selection ─────────────────────────────────────────────────────
# Options: ollama | litai | nim | slm
# slm = on-device Qwen2.5:3b (no API key needed, requires Ollama installed)
MODEL_PROVIDER=slm

# ── SLM — on-device Qwen2.5:3b (default, no key needed) ──────────────────
SLM_MODEL=qwen2.5:3b
SLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434

# ── LitAI (cloud) ─────────────────────────────────────────────────────────
LITAI_API_KEY=your_lightning_ai_key_here
LITAI_BASE_URL=https://lightning.ai/api/v1
LITAI_MODEL=lightning-ai/deepseek-v4-pro

# ── NVIDIA NIM (optional local GPU) ───────────────────────────────────────
NGC_API_KEY=your_nvidia_ngc_key_here
LOCAL_NIM_CACHE=~/.cache/nim
NIM_BASE_URL=http://localhost:8000/v1
NIM_MODEL=deepseek-ai/deepseek-v4-pro

