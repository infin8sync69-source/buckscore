{
  "name": "bucks-miner-gui",
  "version": "0.1.0",
  "description": "Bucks Mining Client — plug-and-play GUI for bucksminer",
  "main": "electron/main.js",
  "scripts": {
    "dev":          "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5174 && electron .",
    "build":        "vite build && electron-builder",
    "build:renderer": "vite build",
    "preview":      "vite preview"
  },
  "dependencies": {
    "react":      "^18.3.1",
    "react-dom":  "^18.3.1",
    "recharts":   "^2.12.7"
  },
  "devDependencies": {
    "@types/react":          "^18.3.3",
    "@types/react-dom":      "^18.3.0",
    "@vitejs/plugin-react":  "^4.3.1",
    "autoprefixer":          "^10.4.19",
    "concurrently":          "^8.2.2",
    "electron":              "^31.0.0",
    "electron-builder":      "^24.13.3",
    "postcss":               "^8.4.38",
    "tailwindcss":           "^3.4.4",
    "typescript":            "^5.4.5",
    "vite":                  "^5.3.1",
    "wait-on":               "^7.2.0"
  },
  "build": {
    "appId": "net.bucks.miner",
    "productName": "Bucks Miner",
    "directories": { "output": "release" },
    "extraResources": [
      {
        "from": "../miner/dist/",
        "to":   "miners/",
        "filter": ["bucksminer*"]
      }
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "public/icon.icns",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
